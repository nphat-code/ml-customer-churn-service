# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDE and Editors
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Data files (track .gitkeep only)
data/*.csv
data/*.xlsx
data/*.parquet
!data/.gitkeep

# Model artifacts (uncomment if models are > 100MB; otherwise small models can be tracked or kept via DVC/Git LFS)
models/*.joblib
models/*.pkl
models/*.onnx
!models/.gitkeep

# Logs and environment variables
*.log
.env
